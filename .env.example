# Copy to .env and fill in. Never commit .env. See SETUP-CHECKLIST.md (outside the repo) for where each value comes from.

# --- App ---
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=
SWEEP_SECRET=
DEMO_TIME_SCALE=1
# One-tap demo sign-in on /sign-in for the owner and both workers (never admin). Default true.
DEMO_QUICK_SIGNIN=

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hail

# --- PayPal (sandbox only; the app refuses to start otherwise) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Connect PayPal (Log in with PayPal): set to true once the feature is enabled on the sandbox app.
PAYPAL_LOGIN_ENABLED=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- AI ---
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Confirm current model IDs in Anthropic's docs before use. Suggested starting points:
AI_MODEL_SCREEN=claude-haiku-5-5
AI_MODEL_VERIFY=claude-sonnet-5-5
AI_MODEL_OPS=claude-sonnet-5-5

# --- Sponsors ---
CHANNEL3_API_KEY=
AG_STUDIO_LICENSE_KEY=

# --- Demo accounts (invented emails) ---
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_WORKER1_EMAIL=
DEMO_WORKER1_PASSWORD=
DEMO_WORKER1_PAYPAL_EMAIL=
DEMO_WORKER2_EMAIL=
DEMO_WORKER2_PASSWORD=
DEMO_WORKER2_PAYPAL_EMAIL=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# --- End-to-end tests (sandbox personal account) ---
E2E_BASE_URL=http://localhost:3000
E2E_PAYPAL_BUYER_EMAIL=
E2E_PAYPAL_BUYER_PASSWORD=
