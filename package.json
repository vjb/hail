{
  "name": "hail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "spike:paypal": "tsx --env-file=.env scripts/spike-paypal.ts",
    "spike:venmo": "tsx --env-file=.env scripts/spike-venmo.ts",
    "webhook:register": "tsx --env-file=.env scripts/register-webhook.ts",
    "e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "screenshots": "tsx --env-file-if-exists=.env scripts/screenshots.ts",
    "key:create": "tsx --env-file-if-exists=.env scripts/create-key.ts",
    "art:export": "tsx scripts/export-art.tsx",
    "eval:screening": "tsx --env-file=.env scripts/eval-screening.ts",
    "eval:proof": "tsx --env-file=.env scripts/eval-proof.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "payout:check": "tsx --env-file=.env scripts/payout-check.ts",
    "sweep:loop": "node --env-file-if-exists=.env scripts/sweep-loop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@contentauth/c2pa-node": "^0.9.10",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/react-paypal-js": "^10.6.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
